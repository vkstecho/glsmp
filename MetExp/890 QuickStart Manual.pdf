         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">[AC890] : HA501027U000_04 : Quick Start Guide to support the Parker SSD 890CS/CD series common bus AC drives (frames B, C &amp; D with STO SIL3/PLe) - English</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Quick Start User Guide to support the Parker SSD 890CS/CD series common bus AC drives (frames B, C &amp; D with STO SIL3/PLe)&#xD;&#xA;</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Parker Hannifin, Automation Group, SSD Drives Division Europe</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Parker Hannifin</rdf:li>
               <rdf:li>SSD Drives</rdf:li>
               <rdf:li>frequency inverter</rdf:li>
               <rdf:li>AC drives</rdf:li>
               <rdf:li>open-loop v/f fluxing</rdf:li>
               <rdf:li>closed-loop v/f fluxing</rdf:li>
               <rdf:li>sensorless flex vector</rdf:li>
               <rdf:li>sensorless servo</rdf:li>
               <rdf:li>variable speed control</rdf:li>
               <rdf:li>function block programming</rdf:li>
               <rdf:li>suitable for operation with permanent magnet AC (PMAC) and AC induction motors</rdf:li>
               <rdf:li>208-500VAC</rdf:li>
               <rdf:li>outputs up to 30kW/40HP</rdf:li>
               <rdf:li>common DC bus rail</rdf:li>
               <rdf:li>active front end</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
